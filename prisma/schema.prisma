// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Wedding {
  id          String   @id @default(cuid())
  name        String
  /// Stable key from the legacy backfill mapping file; lets the backfill be re-run idempotently.
  backfillKey String?  @unique
  /// ISO 4217 code used for every budget amount in this wedding.
  currency    String   @default("USD")
  plannedBudgetMinor Int?
  /// IANA timezone used when an event has none of its own.
  timezone    String?
  /// Greeting pre-selected for new households (existing households keep their own).
  defaultGreeting String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships WeddingMembership[]
  events      Event[]
  vendors     Vendor[]
  budgetItems BudgetItem[]
}

model Vendor {
  version Int @default(0)
  requestKey String? @unique
  id          String    @id @default(cuid())
  weddingId   String
  name        String
  category    String
  contactName String?
  email       String?
  phone       String?
  website     String?
  /// "considering" | "quoted" | "booked" | "declined"
  status      String    @default("considering")
  /// Latest quote, in minor units of the wedding currency.
  quoteMinor  Int?
  /// Private to wedding members.
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  wedding     Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  budgetItems BudgetItem[]
  contracts   VendorContract[]

  @@index([weddingId, deletedAt])
}

/// One expense line. eventId null = shared across the wedding; each line is counted exactly once.
model BudgetItem {
  version Int @default(0)
  requestKey String? @unique
  id             String    @id @default(cuid())
  weddingId      String
  eventId        String?
  vendorId       String?
  category       String
  label          String
  /// Planning estimate (minor units). Ignored for totals once agreedMinor is set.
  estimateMinor  Int       @default(0)
  /// Contracted amount (minor units).
  agreedMinor    Int?
  /// Optional per-person estimate, multiplied by the linked event's attendance.
  perPersonMinor Int?
  /// "invited" | "confirmed"
  perPersonBasis String?
  nextPaymentDueAt DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  wedding  Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  event    Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  vendor   Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  payments BudgetPayment[]

  @@index([weddingId, deletedAt])
  @@index([eventId])
  @@index([vendorId])
}

model BudgetPayment {
  version Int @default(0)
  requestKey String? @unique
  method String?
  reference String?
  deletedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  id           String   @id @default(cuid())
  budgetItemId String
  amountMinor  Int
  paidAt       DateTime
  note         String?
  createdAt    DateTime @default(now())

  budgetItem BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)

  @@index([budgetItemId])
}

model WeddingMembership {
  id        String   @id @default(cuid())
  weddingId String
  userId    String
  /// "owner" | "member". Only owners may administer memberships.
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weddingId, userId])
  @@index([userId])
}

model Event {
  id            String   @id @default(cuid())
  ownerUserId   String?
  owner         User?    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Null only for legacy events that have not been assigned by the backfill mapping yet.
  weddingId     String?
  wedding       Wedding? @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  title         String
  theme         String   @default("modern")
  slug          String
  description   String?
  imagePath     String?
  coupleNames   String?
  eventSubtitle String?
  eventDate     DateTime?
  rsvpDeadline  DateTime?
  eventTime     String?
  venue         String?
  welcomeMessage String?
  itinerary      Json?
  inviteFontStyle String   @default("elegant_serif")
  inviteMessageIntro String?
  inviteMessageLineOverride String?
  genericCardImage String?
  cardImage1       String?
  cardImage2       String?
  cardImage3       String?
  cardImage4       String?
  familyCardImage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  guests        Guest[]
  rsvpActivities RsvpActivity[]
  communicationLogs GuestCommunicationLog[]
  roles         EventRole[]
  allocations   EventAllocation[]
  budgetItems   BudgetItem[]
  /// IANA timezone for this event (falls back to the wedding's).
  timezone      String?

  @@index([slug])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([ownerUserId, deletedAt])
  @@index([weddingId, deletedAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  events       Event[]
  weddingMemberships WeddingMembership[]
  eventRoles         EventRole[]
  eventAllocations   EventAllocation[]
  managedGuests      Guest[] @relation("GuestManager")
  guestCommunicationLogs GuestCommunicationLog[]

  @@index([name])
  @@index([active, name])
}

model AuditActivity {
  id          String   @id @default(cuid())
  eventId     String?
  userId      String?
  userName    String
  actionType  String
  entityType  String
  entityId    String
  entityName  String?
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([actionType, createdAt(sort: Desc)])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String?
  entityType  String
  entityId    String
  eventId     String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([eventId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Guest {
  id             String   @id @default(cuid())
  eventId        String
  guestName      String
  greeting       String   @default("Assalamu Alaikum")
  menCount       Int      @default(0)
  womenCount     Int      @default(0)
  kidsCount      Int      @default(0)
  maxGuests      Int
  token          String
  attending      Boolean?
  attendingCount Int?
  respondedAt    DateTime?
  group          String?
  tableName      String?
  notes          String?
  hostMessage    String?
  isFamilyInvite Boolean  @default(false)
  /** E.g. "+1", "+44". When null, `phone` may be a legacy full/international string. */
  phoneCountryCode String?
  /** National digits (no country code) when `phoneCountryCode` is set; otherwise legacy full phone text. */
  phone          String?
  email          String?
  invitedAt              DateTime?
  inviteChannelLastUsed  String?
  inviteCount            Int      @default(0)
  lastReminderAt         DateTime?
  excludeFromTotals      Boolean  @default(false)
  excludeReason          String?
  excludedGuestCount     Int      @default(0)
  excludedMenCount       Int      @default(0)
  excludedWomenCount     Int      @default(0)
  excludedKidsCount      Int      @default(0)
  sharedGuestKey         String?
  countOwnerEventId      String?
  /// Wedding member who manages this household for this event. Null = organizer/unassigned pool.
  managedByUserId        String?
  /// Allowance this invitation's places are charged to. Null = not charged to any contributor.
  allocationId           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  managedBy  User?            @relation("GuestManager", fields: [managedByUserId], references: [id], onDelete: SetNull)
  allocation EventAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  rsvpActivities RsvpActivity[]
  communicationLogs GuestCommunicationLog[]

  @@index([allocationId, deletedAt])
  @@index([eventId, managedByUserId])

  @@index([eventId])
  @@index([eventId, deletedAt])
  @@index([eventId, excludeFromTotals])
  @@index([sharedGuestKey, deletedAt])
  @@index([countOwnerEventId])
  @@index([token])
}

/// Per-event guest-list role. With no rows for an event, every wedding member keeps full guest editing.
model EventRole {
  id                 String   @id @default(cuid())
  eventId            String
  userId             String
  /// "organizer" | "contributor"
  role               String
  /// Explicit grant letting a contributor edit every household on this event.
  canManageAllGuests Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

/// Invitation places a contributor may allocate for one event (children and plus-ones included).
model EventAllocation {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  places    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests Guest[]

  @@unique([eventId, userId])
}

model GuestCommunicationLog {
  id        String   @id @default(cuid())
  eventId   String
  guestId   String
  userId    String?
  actorName String?
  channel   String
  actionKey String
  label     String
  detail    String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([guestId, createdAt(sort: Desc)])
  @@index([eventId, createdAt(sort: Desc)])
}

model RsvpActivity {
  id          String   @id @default(cuid())
  eventId     String
  guestId     String
  type        String
  description String
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)])
  @@index([guestId, createdAt(sort: Desc)])
}

/// Private attachments; served only through an authenticated, wedding-scoped route.
model VendorContract {
  requestKey String? @unique
  digest String?
  id String @id @default(cuid())
  vendorId String
  name String
  contentType String
  size Int
  content Bytes
  createdAt DateTime @default(now())
  deletedAt DateTime?
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@index([vendorId, deletedAt])
  @@unique([vendorId, digest])
}
