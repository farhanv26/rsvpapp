{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vowpal",
  "main": ".open-next/worker.js", // 👈 Tells wrangler where the server script is
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets", // 👈 Tells wrangler where the images/css/fonts live
    "binding": "ASSETS"
  },
  
    // ...
    "vars": {
      "ADMIN_PASSWORD": "farhan",
      "DATABASE_URL": "postgresql://postgres.ntcybuqsecdiqioflvit:farhanrafiya@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require",
      "DIRECT_URL": "postgresql://postgres:farhanrafiya@db.ntcybuqsecdiqioflvit.supabase.co:5432/postgres?sslmode=require",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_qZmx4rVk8muzGZlqZTRDlw_nvNJCuJB",
      "NEXT_PUBLIC_SUPABASE_URL": "https://ntcybuqsecdiqioflvit.supabase.co",
      "NPM_FLAGS": "--legacy-peer-deps",
      "SUPABASE_STORAGE_BUCKET": "event-invites",
      "SUPABASE_URL": "https://ntcybuqsecdiqioflvit.supabase.co"
    },
    // ...
  
  "observability": {
    "enabled": true
  }
  
}